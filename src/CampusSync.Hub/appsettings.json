{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}" } },
      { "Name": "File", "Args": { "path": "logs/campussync-.json", "rollingInterval": "Day", "retainedFileCountLimit": 7, "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "CampusSync.Hub" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sync": "Data Source=campussync.db"
  },
  "Ethos": {
    "BaseUrl": "http://localhost:5101/",
    "ApiKey": "demo-api-key-123"
  },
  "Targets": {
    "BaseUrl": "http://localhost:5201/"
  },
  "Sync": {
    "PollSeconds": 5,
    "BatchSize": 20
  }
}
